# =============================================================================
# Docker build context exclusions
# Reduces build context size and prevents sensitive files from leaking
# =============================================================================

# Version control
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
.eggs/
dist/
build/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files (NEVER include secrets in image)
.env
.env.*
!.env.example

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation
*.md
docs/
LICENSE

# OS files
.DS_Store
Thumbs.db

# Terraform / K8s (wrong context)
terraform/
kubernetes/
